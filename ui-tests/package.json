{
  "name": "@lightcone-research/jupyterlab-lightcone-ui-tests",
  "version": "1.0.0",
  "description": "Installed JupyterLab Lightcone browser tests",
  "private": true,
  "scripts": {
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "test": "jlpm typecheck && jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jupyterlab/galata": "^5.6.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.26",
    "typescript": "~5.9.3"
  }
}
